{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project",
  "type": "object",
  "required": [
    "id",
    "entity",
    "name",
    "location",
    "role",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^proj_[a-z0-9_]+$"
    },
    "entity": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "power_mw_contracted": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            },
            "last_verified": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "power_mw_energized": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            },
            "last_verified": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "gpu_generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "gpu_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "anchor_tenant": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_years": {
      "type": [
        "number",
        "null"
      ]
    },
    "financing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "facility",
          "lenders",
          "evidence"
        ],
        "properties": {
          "facility": {
            "type": "string"
          },
          "lenders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "balance": {
            "anyOf": [
              {
                "$ref": "#/$defs/amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "collateral_value": {
            "anyOf": [
              {
                "$ref": "#/$defs/amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "secured_by": {
            "type": "string"
          },
          "covenant_ltv": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "expected_completion": {
      "type": [
        "string",
        "null"
      ]
    },
    "nvidia_link": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "$enum": "project_role"
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "object",
      "required": [
        "value",
        "as_of",
        "last_verified",
        "display_eligible",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fiscal_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_currency": {
          "type": "string"
        },
        "original_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "fx_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "display_eligible": {
          "type": "boolean"
        },
        "lower_bound": {
          "type": "boolean"
        },
        "not_applicable": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "price_source": {
          "type": "string"
        },
        "price_timestamp": {
          "type": "string"
        },
        "label": {
          "$enum": "label"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "evidence"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_force": {
          "type": "boolean"
        },
        "effective_note": {
          "type": "string"
        },
        "qualifier": {
          "enum": [
            "nearly",
            "about",
            "more than",
            "up to"
          ]
        },
        "floor": {
          "type": [
            "number",
            "null"
          ]
        },
        "floor_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor_note": {
          "type": "string"
        }
      }
    }
  }
}