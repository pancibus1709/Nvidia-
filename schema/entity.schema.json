{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entity",
  "type": "object",
  "required": [
    "id",
    "name",
    "short_name",
    "cluster",
    "depth",
    "public",
    "country"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ent_[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "cluster": {
      "$enum": "cluster"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "public": {
      "type": "boolean"
    },
    "ticker": {
      "type": [
        "string",
        "null"
      ]
    },
    "cik": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compute_commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "counterparty",
          "description",
          "amount"
        ],
        "properties": {
          "counterparty": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/amount"
          }
        }
      }
    },
    "credit": {
      "type": "object",
      "properties": {
        "grade": {
          "$enum": "grade"
        },
        "grade_reason": {
          "type": "string"
        },
        "public_ratings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "agency",
              "rating",
              "date",
              "evidence"
            ],
            "properties": {
              "agency": {
                "type": "string"
              },
              "rating": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "debt_outstanding": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "maturities_24m": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "cash_and_undrawn": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_spend_12m": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "liquidity_months": {
          "type": "object"
        },
        "top_customer_share": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "value",
                "evidence"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "as_of": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "note": {
                  "type": "string"
                },
                "last_verified": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "top3_customer_share": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "value",
                "evidence"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "as_of": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "note": {
                  "type": "string"
                },
                "last_verified": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "collateral_note": {
          "type": "string"
        },
        "market_signals": {
          "type": "array"
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "object",
      "required": [
        "value",
        "as_of",
        "last_verified",
        "display_eligible",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fiscal_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_currency": {
          "type": "string"
        },
        "original_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "fx_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "display_eligible": {
          "type": "boolean"
        },
        "lower_bound": {
          "type": "boolean"
        },
        "not_applicable": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "price_source": {
          "type": "string"
        },
        "price_timestamp": {
          "type": "string"
        },
        "label": {
          "$enum": "label"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "evidence"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_force": {
          "type": "boolean"
        },
        "effective_note": {
          "type": "string"
        }
      }
    }
  }
}