{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "complex_link",
  "type": "object",
  "required": [
    "id",
    "kind",
    "provider",
    "beneficiary",
    "obligor",
    "instrument",
    "description",
    "status",
    "claim_basis",
    "amounts",
    "trigger",
    "dates",
    "nvidia_links",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx_[a-z0-9_]+$"
    },
    "kind": {
      "enum": [
        "guarantee",
        "backstop",
        "residual_value_guarantee",
        "lease_guarantee",
        "parent_guarantee",
        "credit_support",
        "vendor_financing",
        "share_option_or_warrant",
        "minimum_revenue",
        "compute_contract"
      ]
    },
    "provider": {
      "type": "string",
      "description": "entity id of the party that stands behind the obligation"
    },
    "beneficiary": {
      "type": "string",
      "description": "entity id of the party protected (lender, landlord, supplier)"
    },
    "obligor": {
      "type": "string",
      "description": "entity id of the party whose obligation is supported"
    },
    "instrument": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "status": {
      "$enum": "status"
    },
    "claim_basis": {
      "$enum": "claim_basis"
    },
    "amounts": {
      "type": "object",
      "properties": {
        "headline": {
          "$ref": "#/$defs/amount"
        },
        "maximum": {
          "$ref": "#/$defs/amount"
        },
        "drawn_or_paid": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "trigger": {
      "type": "string"
    },
    "dates": {
      "type": "object",
      "properties": {
        "announced": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective": {
          "type": [
            "string",
            "null"
          ]
        },
        "maturity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "same_capacity_as_nvidia": {
      "type": "boolean",
      "description": "true when the supported obligation also relies on an Nvidia relationship"
    },
    "nvidia_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "same_obligation_as": {
      "type": "string"
    }
  },
  "$defs": {
    "amount": {
      "type": "object",
      "required": [
        "value",
        "as_of",
        "last_verified",
        "display_eligible",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fiscal_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_currency": {
          "type": "string"
        },
        "original_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "fx_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "fx_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "display_eligible": {
          "type": "boolean"
        },
        "lower_bound": {
          "type": "boolean"
        },
        "not_applicable": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "price_source": {
          "type": "string"
        },
        "price_timestamp": {
          "type": "string"
        },
        "label": {
          "$enum": "label"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "evidence"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_force": {
          "type": "boolean"
        },
        "effective_note": {
          "type": "string"
        },
        "qualifier": {
          "enum": [
            "nearly",
            "about",
            "more than",
            "up to"
          ]
        },
        "floor": {
          "type": [
            "number",
            "null"
          ]
        },
        "floor_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor_note": {
          "type": "string"
        },
        "price": {
          "type": [
            "number",
            "null"
          ]
        },
        "shares": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}